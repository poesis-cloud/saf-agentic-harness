@startuml adapter-src-classes

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam PackagePadding 12
skinparam ClassPadding 4

package "CD - Adapter classes (vscode-github-copilot-chat)" <<Frame>> {

  package "harness core (external, see ../../core/harness-src-classes.puml)" as harness_core #eeeeee {
    interface Command <<external>> {
      +execute_function(inquiry: Inquiry) : Report
    }
    abstract class Inquiry <<external>> {
      +session_id : str
      +parent_session_id : str | None
    }
    abstract class Report <<external>> {
      +context : Context
      +outcome : Outcome
    }
  }

  package "vscode-github-copilot-chat (the adapter - outside src/, depends ONLY on the harness core's commands)" as adapter {
    class HookEvent <<dataclass>> {
      +hook_event_name : str
      +timestamp : str
      +raw_host_session_id : str
      +tool_name : str | None
      +tool_input : Mapping[str, Any]
      +payload : Mapping[str, Any]
    }
    class HookDecision <<dataclass>> {
      +exit_code : int
      +stdout : str
    }
    class HookBinding <<dataclass>> {
      +write_tools : Mapping[str, str]
      +delete_tools : tuple[str, ...]
      +dispatch_tools : tuple[str, ...]
      +mediated_command_tools : tuple[str, ...]
      +tool_keys : tuple[str, ...]
      +input_keys : tuple[str, ...]
      +path_keys : tuple[str, ...]
      +nested_path_keys : tuple[str, ...]
      +host_session_keys : tuple[str, ...]
      +host_step_session_keys : tuple[str, ...]
      +host_step_actor_keys : tuple[str, ...]
      +dispatch_agent_keys : tuple[str, ...]
      +dispatch_model_keys : tuple[str, ...]
      +model_ids : Mapping[str, str]
      +resolve_event_class(event: HookEvent) : EventClass
      +resolve_write_action(tool: str) : str
      +extract_artifact_paths(tool_input: Mapping[str, Any]) : tuple[Path, ...]
      +resolve_model_id(host_model: str) : str
    }
    class HookClassifier {
      -_binding : HookBinding
      +classify_event(event: HookEvent) : EventClass
    }
    enum EventClass {
      SESSION_STARTED
      STEP_STARTING
      STEP_STARTED
      WRITE_STARTING
      WRITE_ENDED
      STEP_ENDED
      SESSION_ENDED
      MEDIATED_ATTRIBUTION
      PASS_THROUGH
    }
    class SessionTracker {
      -_store_path : Path
      +push_current(raw_host_id: str, session_id: str) : None
      +pop_current(raw_host_id: str) : None
      +clear_current(raw_host_id: str) : None
      +reset_current(raw_host_id: str, session_id: str) : None
      +resolve_current(raw_host_id: str) : str | None
    }
    class Adapter {
      -_binding : HookBinding
      -_classifier : HookClassifier
      -_tracker : SessionTracker
      -_renderer : HookRenderer
      -_commands : Mapping[EventClass, tuple[Command, ...]]
      +handle_hook_event(event: HookEvent) : HookDecision
    }
    class HookRenderer {
      -_binding : HookBinding
      +render_decision(event_class: EventClass, reports: tuple[Report, ...]) : HookDecision
      +render_stamped_input(event: HookEvent, session_id: str) : HookDecision
      +render_pass_through() : HookDecision
    }

    note bottom of Adapter
      This adapter's only host-aware code, depending
      EXCLUSIVELY on ""Command"" and the ""Inquiry""
      types it builds - the harness core's public API. No
      ""services"", no ""stores"", no ""config"": basic
      layering, an adapter depends on a system's public
      surface, never its internals. Session identification
      uses only host-observed event data (""HookBinding"" is
      this adapter's OWN configuration, loaded by its own
      tools - never the harness's ""ConfigLoader"") plus
      ""SessionTracker""'s own private bookkeeping. Framework-
      agent gating (C7), step-resolution correlation, and
      session-closure enforcement (C8) are NOT decided here:
      they are validated inside the invoked commands
      themselves (the harness's ""SessionLifecycle"" and
      checking services already hold what they need for
      their own reasons) - this class only relays whatever
      outcome comes back, generically, to the host decision.
      A write tool naming several paths (I8) fans out to one
      function-8 / function-9 invocation per distinct path
      via ""HookBinding.extract_artifact_paths"", collapsed
      into a single host decision by ""HookRenderer"".
      There is only ONE adapter today; if a second host is
      ever added, whatever proves genuinely shared factors out
      then - not speculatively now.
    end note
    note bottom of SessionTracker
      This adapter's OWN small persistent record - NOT the
      harness's ""SessionLogStore"". A STACK per raw host id
      (verified: a subagent's own ""session_id"" is the SAME
      shared id as its dispatching session's, never its own
      ""agent_id"" - see I13): H0 resets it fresh per turn,
      H1 PUSHes the new step session as current, H7 POPs it
      back to the dispatching session on SubagentStop and
      CLEARs the whole stack on Stop (a later firing under
      a non-framework agent then resolves to None - C7
      pass-through, never a stale session). Every
      other hook (H2/H3/H4/H5/H6) only reads the top via
      ""resolve_current"". Tracks "current" only - whether a
      session has since CLOSED is the harness core's own
      fact (C8, function 11), never duplicated here. Plain
      file I/O, no harness dependency.
    end note
    note bottom of EventClass
      NINE classes: the seven harness boundaries plus the two
      host events that reach no harness function. Lifecycle
      participles avoid the step/session clash
      (1 step = 1 session): STEP_STARTING is the dispatch
      about to open the step - it can DENY; STEP_STARTED is
      the step session having opened - it can only INJECT;
      STEP_ENDED is the dispatch return - THE evaluation
      point. SESSION_STARTED is a non-step (orchestrator)
      session starting. SESSION_ENDED (H7) invokes function
      11 for real now - best-effort, whichever session
      ""SessionTracker"" resolves as current for the firing.
      STEP_STARTING and STEP_ENDED occur
      in the dispatching (orchestrator) session - their
      entries journal to its log.
      MEDIATED_ATTRIBUTION (H4) invokes NO function: it
      stamps the resolved session id onto the model-authored
      harness command the host is about to run. PASS_THROUGH
      is every other firing - foreign session, non-artifact
      path, unclassified tool - answered with exit 0 and
      empty output. Only the seven boundaries appear in
      ""Adapter._commands""; the other two are rendered
      directly. Host events outside these classes are
      adapter telemetry - never journaled.
    end note
  }

  ' --- the ONLY allowed edge into the harness core ---
  adapter ..> harness_core : the ONLY allowed edge -\nthe harness core's public API
}

@enduml
