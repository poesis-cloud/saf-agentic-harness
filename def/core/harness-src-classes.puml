@startuml harness-src-classes

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam PackagePadding 12
skinparam ClassPadding 4

package "CD - Harness core classes (src/)" <<Frame>> {

  class Application {
    -_commands : Mapping[str, Command]
    +dispatch_command(argv: Sequence[str]) : int
  }

  package "commands" {
    interface Command {
      +execute_function(invocation: FunctionInvocation) : Report
    }
    class StartSessionCommand {
      -_lifecycle : SessionLifecycle
    }
    class EndSessionCommand {
      -_lifecycle : SessionLifecycle
    }
    class ResolveStepCommand {
      -_step_resolver : StepResolver
    }
    class ResolveStepModelCommand {
      -_model_resolver : StepModelResolver
    }
    class CheckStepPreconditionsCommand {
      -_checker : StepPreconditionChecker
    }
    class CheckStepPostconditionsCommand {
      -_checker : StepPostconditionChecker
    }
    class CheckStepAuthorizationCommand {
      -_checker : StepAuthorizationChecker
    }
    class CheckStepArtifactCommand {
      -_checker : StepArtifactChecker
    }
    class ResolveWorkflowInstructionsCommand {
      -_resolver : WorkflowInstructionResolver
    }
    class ResolveWorkflowSkillsCommand {
      -_resolver : WorkflowSkillResolver
    }
    class ResolveStepInstructionsCommand {
      -_resolver : StepInstructionResolver
    }
    class ResolveStepSkillsCommand {
      -_resolver : StepSkillResolver
    }
    note bottom of ResolveStepCommand
      No command composes services: functions 3 and 4
      are fully independent - whoever needs both
      (the orchestrator per its instructions, or
      whatever mediates a given host's hook events)
      composes them OUTSIDE the harness core.
    end note
    note bottom of Command
      TWELVE commands - exactly one per harness function,
      hook- and host-blind. Commands are the JSON boundary:
      parse the FunctionInvocation input object (session
      attribution fields + function-specific fields),
      invoke the service, and return the exact concrete
      Report object that becomes command ""out"" and
      log entry ""report"". Any event->boundary->functions
      orchestration happens entirely outside src/, never
      inside a command.
    end note
  }

  package "services" {

    package "session_lifecycle" {
      class SessionLifecycle {
        -_session_log_store : SessionLogStore
        +start_session(agent: str, session_id: str, parent_session_id: str | None) : SessionStartReport
        +end_session(session_id: str) : SessionEndReport
      }
      class SessionStartReport <<dataclass>> {
        +session : SessionRef
      }
      class SessionEndReport <<dataclass>> {
      }
      class SessionRef <<dataclass>> {
        +agent : str
        +session_id : str
        +parent_session_id : str | None
      }
      note bottom of SessionLifecycle
        ""start_session"" (function 0) and ""end_session""
        (function 11) are the session's two boundary
        writes to its own log - starting (always first)
        and ending (best-effort, C8). ""end_session""
        is idempotent: ending an already-ended or
        never-started id is a no-op, not an error.
      end note
    }

    package "step_resolution" {
      class StepResolver {
        -_session_log_store : SessionLogStore
        -_catalog : WorkflowCatalog
        +resolve_step(invocation: FunctionInvocation, workflow_slug: str) : StepResolutionReport
      }
      class StepResolutionReport <<dataclass>> {
        +workflow_slug : str
        +workflow_instance_id : str
        +step : Step | None
      }
    }

    package "model_resolution" {
      class StepModelResolver {
        -_session_log_store : SessionLogStore
        -_catalog : WorkflowCatalog
        -_profiles : ModelProfiles
        +resolve_step_model(invocation: FunctionInvocation) : ModelProfileReport
      }
      class ModelProfileReport <<dataclass>> {
        +profile : ModelProfileBinding
      }
      class ModelProfileBinding <<dataclass>> {
        +slug : str
        +score : float
        +costRank : int
        +reason : str
      }
    }

    package "checking" {
      class StepPreconditionChecker {
        -_evaluator : ConditionEvaluator
        -_session_log_store : SessionLogStore
        -_catalog : WorkflowCatalog
        +check_step_preconditions(invocation: FunctionInvocation) : ConditionCheckReport
      }
      class StepPostconditionChecker {
        -_evaluator : ConditionEvaluator
        -_session_log_store : SessionLogStore
        -_catalog : WorkflowCatalog
        +check_step_postconditions(invocation: FunctionInvocation) : ConditionCheckReport
      }
      class StepAuthorizationChecker {
        -_acl : AccessControlList
        -_workspace_layout : WorkspaceLayout
        +check_step_authorization(invocation: FunctionInvocation, artifact_path: Path) : AuthorizationReport
      }
      class StepArtifactChecker {
        -_artifact_store : ArtifactStore
        +check_step_artifact(invocation: FunctionInvocation, artifact_path: Path) : ArtifactCheckReport
      }
      class ConditionEvaluator {
        -_artifact_store : ArtifactStore
        +evaluate_conditions(conditions: tuple[StepCondition | StateCondition, ...], view: WorkflowInstanceView) : tuple[ConditionCheck, ...]
      }
      class ConditionCheckReport <<dataclass>> {
        +condition_checks : tuple[ConditionCheck, ...]
      }
      class AuthorizationReport <<dataclass>> {
        +authorization : Authorization
      }
      class Authorization <<dataclass>> {
        +actor : str
        +artifact_path : Path
        +failure_message : str | None
      }
      class ArtifactCheckReport <<dataclass>> {
        +artifact_check : ArtifactCheck | None
      }
      class ArtifactCheck <<dataclass>> {
        +failure_message : str
        +revert : Revert | None
      }
      class Revert <<dataclass>> {
        +action : str
        +from_ref : str | None
      }
      class CheckReport <<dataclass>> {
        +findings : tuple[Finding, ...]
      }
      class ConditionCheck <<dataclass>> {
        +condition : StepCondition | StateCondition
        +outcome : str
        +failure_message : str | None
      }
    }

    package "context_resolution" {
      class WorkflowInstructionResolver {
        -_catalog : WorkflowCatalog
        +resolve_workflow_instructions(invocation: FunctionInvocation) : WorkflowInstructionsReport
      }
      class WorkflowSkillResolver {
        -_catalog : WorkflowCatalog
        +resolve_workflow_skills(invocation: FunctionInvocation) : WorkflowSkillsReport
      }
      class StepInstructionResolver {
        -_catalog : WorkflowCatalog
        +resolve_step_instructions(invocation: FunctionInvocation) : StepInstructionsReport
      }
      class StepSkillResolver {
        -_catalog : WorkflowCatalog
        +resolve_step_skills(invocation: FunctionInvocation) : StepSkillsReport
      }
      class WorkflowInstructionsReport <<dataclass>> {
        +instructions : tuple[str, ...]
      }
      class WorkflowSkillsReport <<dataclass>> {
        +skills : tuple[str, ...]
      }
      class StepInstructionsReport <<dataclass>> {
        +instructions : tuple[str, ...]
      }
      class StepSkillsReport <<dataclass>> {
        +skills : tuple[str, ...]
      }
    }
  }

  package "stores" {
    note as StoresNote
      ""stores"" mirrors ""services"": one FAMILY subpackage
      per store, each homing its own persisted (or
      derived) dataclasses - no gateway, no facade.
      Services depend on exactly the store(s) they need.
      Frozen dataclasses throughout - public typed
      attributes, no getters/setters.
    end note

    package "artifact_store" {
      class ArtifactStore {
        -_workspace_layout : WorkspaceLayout
        -_validator : SchemaValidator
        +discover_artifacts(selector: str) : tuple[Artifact, ...]
        +scan_raw_paths(scope: Path) : Iterator[Path]
        +validate_artifact(artifact_path: Path) : tuple[Finding, ...]
        +commit_artifact(artifact_path: Path) : None
        +revert_artifact(artifact_path: Path) : Finding
      }
      class Artifact <<dataclass>> {
        +ref : str
        +kind : str
        +data : Mapping[str, Any]
      }
      class Finding <<dataclass>> {
        +source : str
        +rule : str
        +message : str
      }
      note bottom of ArtifactStore
        Owns the artifact side (C6): workspace state is
        committed state (HEAD), the working tree is the
        write staging area. ""discover_artifacts"" reads
        committed state and raises on an invalid artifact;
        ""scan_raw_paths"" enumerates the raw universe for
        sweeps; ""commit_artifact"" promotes a validated
        staged write into state and ""revert_artifact""
        discards an invalid one - the harness's only
        deliberate Git actions. Finding is homed here - the
        schema-validation finding every check composes
        (CheckReport.findings).
      end note
    }

    package "session_log_store" {
      class FunctionInvocation <<dataclass>> {
        +session_id : str
        +parent_session_id : str | None
        +fields : Mapping[str, Any]
      }
      class SessionLogStore {
        -_jsonl : JsonlStore
        +create_session_log(entry: LogEntry) : Log
        +mint_workflow_instance_id(workflow_slug: str) : str
        +load_session_log(session_id: str) : Log
        +load_workflow_instance_view(workflow_instance_id: str) : WorkflowInstanceView
        +append_log_entry(session_id: str, entry: LogEntry) : None
      }
      class Log <<dataclass>> {
        +session_id : str
        +entries : tuple[LogEntry, ...]
      }
      class LogEntry <<dataclass>> {
        +ts : str
        +report : Report
      }
      class StepRef <<dataclass>> {
        +slug : str
        +actor : str
        +artifact : str | None
      }
      abstract class Report <<dataclass>> {
        +context : Context
        +outcome : Outcome
      }
      class Context <<dataclass>> {
        +function : str
        +session_id : str
        +parent_session_id : str | None
        +workflow_instance_id : str | None
      }
      class Outcome <<dataclass>> {
        +status : str
        +error : Error | None
      }
      class Error <<dataclass>> {
        +code : str
        +message : str
        +retryable : bool | None
      }
      class WorkflowInstanceView <<dataclass>> {
        +workflow_instance_id : str
        +entries : tuple[LogEntry, ...]
        +list_executed_steps() : frozenset[str]
        +find_latest_outcome(step_slug: str) : LogEntry | None
        +find_unresolved_step_resolution(actor: str) : LogEntry | None
      }
      LogEntry o-- Report
      Report o-- Context
      Report o-- Outcome
      Outcome o-- Error
      note bottom of SessionLogStore
        Owns the log side: 1 session = 1 writer = 1 file,
        created by function 0's start entry (the
        file's first line) and, best-effort, closed by
        function 11's entry (the file's last line, C8);
        ""load_workflow_instance_view"" assembles the cross-log ""WorkflowInstanceView"" -
        discovery scan + ts ordering under the single-driver
        invariant (see Logging). Report is the abstract base
        every service result extends (the subtypes live with
        their services); the log entry wraps the report with
        ""ts"" only - context and outcome live on the Report
        base. WorkflowInstanceView is assembled here, never
        persisted.
      end note
    }
  }

  package "config" {
    class ConfigLoader {
      -_env : EnvLoader
      -_yaml : YamlLoader
      -_validator : SchemaValidator
      +load_framework_layout(root: Path) : FrameworkLayout
      +load_access_control_list(root: Path) : AccessControlList
      +load_model_profiles(root: Path) : ModelProfiles
      +load_workspace_layout(root: Path) : WorkspaceLayout
      +load_workflow_catalog(root: Path) : WorkflowCatalog
    }
    class FrameworkLayout <<dataclass>> {
      +framework_dir : Path
      +skills_dir : Path
      +agents_dir : Path
      +schemas_dir : Path
      +templates_dir : Path
      +workspace_dir : Path
    }
    class AccessControlList <<dataclass>> {
      +grants : Mapping[str, frozenset[str]]
      +is_framework_agent(actor: str) : bool
      +list_privileges(actor: str) : frozenset[str]
    }
    class ModelProfiles <<dataclass>> {
      +profiles : Mapping[str, ModelProfile]
      +score_model(model: str, capabilities: Mapping[str, int]) : float
    }
    class ModelProfile <<dataclass>> {
      +capabilities : Mapping[str, int]
      +costRank : int
    }
    class WorkspaceLayout <<dataclass>> {
      +nodes : tuple[ArtifactNode | FolderNode, ...]
      +resolve_resource(path: Path) : str
    }
    class ArtifactNode <<dataclass>> {
      +slug : str
      +description : str
      +cardinality : str
      +artifact : str
      +template : str
    }
    class FolderNode <<dataclass>> {
      +slug : str
      +description : str
      +cardinality : str | None
      +children : tuple[ArtifactNode | FolderNode, ...]
    }
    class WorkflowCatalog <<dataclass>> {
      +workflows : tuple[Workflow, ...]
      +find_workflow(slug: str) : Workflow
      +list_facilitated_workflows(actor: str) : tuple[Workflow, ...]
    }
    class Workflow <<dataclass>> {
      +slug : str
      +facilitator : str
      +after : tuple[str, ...]
      +guidance : str
      +steps : tuple[Step, ...]
    }
    class Step <<dataclass>> {
      +slug : str
      +actor : str
      +artifact : str
      +skills : tuple[str, ...]
      +instructions : tuple[str, ...]
      +conditions : tuple[StepCondition | StateCondition, ...]
      +capabilities : Mapping[str, int]
    }
    class StepCondition <<dataclass>> {
      +kind : str
      +slug : str
      +step : str
    }
    class StateCondition <<dataclass>> {
      +kind : str
      +slug : str
      +setSelector : Mapping[str, Any]
      +setPredicate : str
    }
    note bottom of ConfigLoader
      Parse + contract-validate + semantic rules
      + dataclass construction: ONE act per source.
      utils supplies the mechanics; this class owns
      the source-contract pairing and the fail-fast.
      The configuration dataclasses live here, beside
      their loader.
    end note
  }

  package "utils" {
    note as UtilsNote
      Two layers: LOADERS - one per format - and
      HIGHER-LEVEL utilities abstracting them
      (SchemaValidator loads contracts through
      JsonLoader; JsonlStore persists through it).
    end note
    class EnvLoader {
      +load_env(path: Path) : Mapping[str, str]
    }
    class JsonLoader {
      +load_json(path: Path) : dict
    }
    class YamlLoader {
      +load_yaml(path: Path) : dict
    }
    class MarkdownLoader {
      +load_markdown(path: Path) : dict
    }
    class JsonlStore {
      -_json : JsonLoader
      +load_entries(path: Path) : tuple[dict, ...]
      +append_entry(path: Path, obj: dict) : None
    }
    class SchemaValidator {
      -_json : JsonLoader
      +validate_instance(instance: Any, contract: Path) : tuple[str, ...]
    }
  }

  package "external (third-party)" #eeeeee {
    class "cel-python" as CelPython <<library>>
    class "jsonschema" as JsonSchemaLib <<library>>
    class "PyYAML" as PyYamlLib <<library>>
  }

  ' --- command surface: one command per harness function (1:1) ---
  Command <|.. StartSessionCommand
  Command <|.. EndSessionCommand
  Command <|.. ResolveStepCommand
  Command <|.. ResolveStepModelCommand
  Command <|.. CheckStepPreconditionsCommand
  Command <|.. CheckStepPostconditionsCommand
  Command <|.. CheckStepAuthorizationCommand
  Command <|.. CheckStepArtifactCommand
  Command <|.. ResolveWorkflowInstructionsCommand
  Command <|.. ResolveWorkflowSkillsCommand
  Command <|.. ResolveStepInstructionsCommand
  Command <|.. ResolveStepSkillsCommand
  Application ..> Command : builds + dispatches\n(composition root, at src root)
  Application ..> ConfigLoader : builds every config\ndataclass fail-fast at start

  ' --- external dependencies ---
  ConditionEvaluator ..> CelPython : compile + evaluate\nCEL selectors/predicates
  SchemaValidator ..> JsonSchemaLib : contract compilation\n+ instance validation
  YamlLoader ..> PyYamlLib : safe_load

  ' --- result <-> report correlation: every service result IS a Report subtype ---
  Report <|-- SessionStartReport
  Report <|-- SessionEndReport
  Report <|-- StepResolutionReport
  Report <|-- ModelProfileReport
  Report <|-- CheckReport
  Report <|-- ConditionCheckReport
  Report <|-- AuthorizationReport
  Report <|-- ArtifactCheckReport
  Report <|-- WorkflowInstructionsReport
  Report <|-- WorkflowSkillsReport
  Report <|-- StepInstructionsReport
  Report <|-- StepSkillsReport
  CheckReport "findings" o-- Finding : every check finding is\nthe Finding homed in\nstores/artifact_store
  SessionStartReport o-- SessionRef
  ConditionCheckReport o-- ConditionCheck
  AuthorizationReport o-- Authorization
  ArtifactCheckReport o-- ArtifactCheck
  ArtifactCheck o-- Revert
  ModelProfileReport o-- ModelProfileBinding
  StepResolutionReport o-- Step : the configured step,\nverbatim
  note on link
    Every service returns a Report subtype (homed in
    stores/session_log_store); ""context"" and ""outcome""
    live on the base - every result carries its function's
    outcome by construction, under one shared field
    name with function-owned values. The command
    returns that exact object as the contract ""out""
    JSON and the log entry persists it verbatim as
    ""report"", wrapped by the entry's own ""ts"" only.
  end note

  ' --- one dependency direction ---
  "commands" ..> "services"
  "services" ..> "stores"
  "services" ..> "config"
  "stores" ..> "utils"
  "config" ..> "utils"

  note bottom of "services"
    One service per harness function (1:1:1 with commands),
    grouped in subpackages by family - session_registration /
    step_resolution / model_resolution / checking /
    context_resolution - and each result dataclass is homed in
    the subpackage of the classes returning it, exclusively.
    Dependencies are constructor-injected private attributes;
    method names are verb + subject; commands render the typed
    results to the contract ""out"" JSON.
  end note
}

@enduml
