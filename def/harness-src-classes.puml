@startuml harness-src-classes

' ============================================================
' VISUAL THEME
' ============================================================
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam PackagePadding 12
skinparam ClassPadding 4

package "CD - Harness source classes (src/)" <<Frame>> {

  class Application {
    -_commands : Mapping[str, Command]
    +dispatch_command(argv: Sequence[str]) : int
  }

  package "commands" {
    interface Command {
      +execute_function(payload: dict) : dict
    }
    class HookCommand {
      -_normalizer : HookNormalizer
      -_correlator : SessionCorrelator
      -_commands : Mapping[Boundary, Command]
      +execute_function(payload: dict) : dict
    }
    class ResolveStepCommand {
      -_step_resolver : StepResolver
      -_model_resolver : StepModelResolver
    }
    class ResolveStepModelCommand {
      -_model_resolver : StepModelResolver
    }
    class CheckStepPreconditionsCommand {
      -_checker : StepPreconditionChecker
    }
    class CheckStepPostconditionsCommand {
      -_checker : StepPostconditionChecker
    }
    class CheckStepAuthorizationCommand {
      -_checker : StepAuthorizationChecker
    }
    class CheckStepArtifactsCommand {
      -_checker : StepArtifactChecker
    }
    class InjectWorkflowInstructionsCommand {
      -_injector : WorkflowInstructionInjector
    }
    class InjectWorkflowSkillsCommand {
      -_injector : WorkflowSkillInjector
    }
    class InjectStepInstructionsCommand {
      -_injector : StepInstructionInjector
    }
    class InjectStepSkillsCommand {
      -_injector : StepSkillInjector
    }
    class AuditWorkflowInstanceCommand {
      -_auditor : WorkflowInstanceAuditor
    }
    class CheckWorkspaceCommand {
      -_checker : WorkspaceChecker
    }
    class CheckConfigurationCommand {
      -_checker : ConfigurationChecker
    }
    note bottom of ResolveStepCommand
      The one composing command: function 1's ""out""
      embeds function 2's binding, so this command
      invokes StepResolver then StepModelResolver
      and merges both results into the contract JSON -
      the services stay independent of each other.
    end note
    note bottom of Command
      Commands are the JSON boundary: parse the
      function's ""in"" object, invoke the service(s),
      render the typed result(s) to the ""out"" object
      per ""contracts/functions/<function>.io.schema.json"".
    end note
  }

  package "services" {

    package "step_resolution" {
      class StepResolver {
        -_workspace : Workspace
        -_catalog : WorkflowCatalog
        +resolve_step(workflow_slug: str, workflow_instance_id: str | None) : StepResolution
      }
      class StepResolution <<dataclass>> {
        +workflow_slug : str
        +workflow_instance_id : str
        +step : Step | None
        +successors : tuple[str, ...]
      }
    }

    package "model_resolution" {
      class StepModelResolver {
        -_profiles : ModelProfiles
        +resolve_step_model(capabilities: Mapping[str, int]) : ModelBinding
      }
      class ModelBinding <<dataclass>> {
        +model : str
        +score : float
        +cost_rank : int
        +reason : str
      }
    }

    package "checking" {
      class StepPreconditionChecker {
        -_evaluator : ConditionEvaluator
        -_workspace : Workspace
        -_catalog : WorkflowCatalog
        +check_step_preconditions(workflow_slug: str, workflow_instance_id: str, step_slug: str) : CheckReport
      }
      class StepPostconditionChecker {
        -_evaluator : ConditionEvaluator
        -_workspace : Workspace
        -_catalog : WorkflowCatalog
        +check_step_postconditions(workflow_slug: str, workflow_instance_id: str, step_slug: str) : CheckReport
      }
      class StepAuthorizationChecker {
        -_acl : AccessControlList
        -_workspace_layout : WorkspaceLayout
        -_workspace : Workspace
        +check_step_authorization(actor: str, artifact_path: Path) : CheckReport
      }
      class StepArtifactChecker {
        -_workspace : Workspace
        +check_step_artifacts(artifact_path: Path) : CheckReport
      }
      class WorkflowInstanceAuditor {
        -_acl : AccessControlList
        -_workspace : Workspace
        +audit_workflow_instance(workflow_instance_id: str) : CheckReport
      }
      class WorkspaceChecker {
        -_workspace : Workspace
        +check_workspace(scope: str, root: Path | None) : CheckReport
      }
      class ConfigurationChecker {
        -_loader : ConfigLoader
        +check_configuration(root: Path) : CheckReport
      }
      class ConditionEvaluator {
        -_workspace : Workspace
        +evaluate_conditions(conditions: tuple[Condition, ...], log: Log) : tuple[ConditionOutcome, ...]
      }
      class CheckReport <<dataclass>> {
        +passed : bool
        +reports : tuple[Report, ...]
        +outcomes : tuple[ConditionOutcome, ...]
      }
      class ConditionOutcome <<dataclass>> {
        +condition_id : str
        +outcome : str
        +report : str | None
      }
    }

    package "injection" {
      class WorkflowInstructionInjector {
        -_catalog : WorkflowCatalog
        +inject_workflow_instructions(facilitator: str) : Injection
      }
      class WorkflowSkillInjector {
        -_catalog : WorkflowCatalog
        +inject_workflow_skills(facilitator: str) : Injection
      }
      class StepInstructionInjector {
        -_catalog : WorkflowCatalog
        +inject_step_instructions(workflow_instance_id: str, step_slug: str) : Injection
      }
      class StepSkillInjector {
        -_catalog : WorkflowCatalog
        +inject_step_skills(workflow_instance_id: str, step_slug: str) : Injection
      }
      class Injection <<dataclass>> {
        +step_slug : str | None
        +instructions : tuple[str, ...]
        +prompts : tuple[str, ...]
        +skills : tuple[str, ...]
        +catalog : Mapping[str, WorkflowPosition]
      }
      class WorkflowPosition <<dataclass>> {
        +after : tuple[str, ...]
        +guidance : str
      }
    }

    package "hooks" {
      class HookNormalizer {
        -_binding : AdapterBinding
        -_acl : AccessControlList
        +normalize_event(event: dict) : Boundary
      }
      enum Boundary {
        SESSION_STARTED
        OBSERVING
        STEP_STARTING
        STEP_STARTED
        STEP_ENDING
        STEP_ENDED
        WRITE_STARTING
        WRITE_ENDED
      }
      class SessionCorrelator {
        -_workspace : Workspace
        +correlate_session(actor: str) : LogEntry | None
      }
    }

    note bottom of SessionCorrelator
      Hook-plane collaborator (used by HookCommand,
      not by the injectors): resolves a session-start
      event's actor to the open dispatch, supplying
      the injectors' In (workflow_instance_id, step_slug)
      or selecting the workflow injectors when none.
    end note
    note bottom of Boundary
      Lifecycle participles avoid the step/session clash
      (1 step = 1 session): STEP_STARTING is the dispatch
      about to open the step - it can DENY; STEP_STARTED is
      the step session having opened - it can only INJECT;
      STEP_ENDING is the step session ending (record only);
      STEP_ENDED is the dispatch return - THE evaluation
      point. SESSION_STARTED is a non-step (facilitator)
      session starting; OBSERVING records a user prompt.
    end note
  }

  package "models" {
    note as ModelsNote
      ""models"" holds the PERSISTED dataclasses only:
      the artifact and the journal (Report persists
      inside every LogEntry). Frozen dataclasses -
      public typed attributes, no getters/setters;
      methods are derived queries (verb + subject).
    end note

    class Artifact <<dataclass>> {
      +ref : str
      +kind : str
      +data : Mapping[str, Any]
    }
    class Log <<dataclass>> {
      +workflow_instance_id : str
      +entries : tuple[LogEntry, ...]
      +list_executed_steps() : frozenset[str]
      +find_latest_outcome(step_slug: str) : LogEntry | None
      +find_open_dispatch(actor: str) : LogEntry | None
    }
    class LogEntry <<dataclass>> {
      +command : str
      +workflow_instance_id : str
      +step_slug : str | None
      +artifact : str | None
      +actor : str
      +status : str
      +report : str
      +payload : Mapping[str, Any]
    }
    class Report <<dataclass>> {
      +source : str
      +rule : str
      +message : str
    }
  }

  package "workspace" {
    class Workspace {
      -_workspace_layout : WorkspaceLayout
      -_validator : SchemaValidator
      -_jsonl : JsonlStore
      +discover_artifacts(selector: str) : tuple[Artifact, ...]
      +scan_raw_paths(scope: Path) : Iterator[Path]
      +validate_artifact(artifact_path: Path) : tuple[Report, ...]
      +revert_artifact(artifact_path: Path) : Report
      +open_workflow_instance(workflow_slug: str) : str
      +load_instance_log(workflow_instance_id: str) : Log
      +append_log_entry(workflow_instance_id: str, entry: LogEntry) : None
    }
    note bottom of Workspace
      The single data-access facade: artifacts AND
      instance journals. Enforces C6:
      ""discover_artifacts"" raises on an invalid artifact;
      ""revert_artifact"" is the single deliberate write.
    end note
  }

  package "config" {
    class ConfigLoader {
      -_env : EnvLoader
      -_yaml : YamlLoader
      -_validator : SchemaValidator
      +load_framework_layout(root: Path) : FrameworkLayout
      +load_access_control_list(root: Path) : AccessControlList
      +load_model_profiles(root: Path) : ModelProfiles
      +load_workspace_layout(root: Path) : WorkspaceLayout
      +load_workflow_catalog(root: Path) : WorkflowCatalog
      +load_adapter_binding(env: str) : AdapterBinding
    }
    class FrameworkLayout <<dataclass>> {
      +skills_dir : Path
      +agents_dir : Path
      +schemas_dir : Path
      +templates_dir : Path
      +workspace_root : Path
    }
    class AccessControlList <<dataclass>> {
      +grants : Mapping[str, frozenset[str]]
      +is_framework_agent(actor: str) : bool
      +list_privileges(actor: str) : frozenset[str]
    }
    class ModelProfiles <<dataclass>> {
      +profiles : Mapping[str, ModelProfile]
      +score_model(model: str, capabilities: Mapping[str, int]) : float
    }
    class ModelProfile <<dataclass>> {
      +capability_scores : Mapping[str, int]
      +cost_rank : int
    }
    class WorkspaceLayout <<dataclass>> {
      +nodes : tuple[WorkspaceNode, ...]
      +resolve_resource(path: Path) : str
    }
    class WorkspaceNode <<dataclass>> {
      +path : str
      +schema : str
      +cardinality : str
    }
    class WorkflowCatalog <<dataclass>> {
      +workflows : tuple[Workflow, ...]
      +find_workflow(slug: str) : Workflow
      +list_facilitated_workflows(actor: str) : tuple[Workflow, ...]
      +list_successors(slug: str) : tuple[str, ...]
    }
    class Workflow <<dataclass>> {
      +slug : str
      +facilitator : str
      +after : tuple[str, ...]
      +guidance : str
      +steps : tuple[Step, ...]
    }
    class Step <<dataclass>> {
      +slug : str
      +actor : str
      +artifact : str
      +skills : tuple[str, ...]
      +instructions : tuple[str, ...]
      +prompts : tuple[str, ...]
      +preconditions : tuple[Condition, ...]
      +postconditions : tuple[Condition, ...]
      +capabilities : Mapping[str, int]
    }
    class Condition <<dataclass>> {
      +condition_id : str
      +after : str | None
      +state : str | None
    }
    class AdapterBinding <<dataclass>> {
      +tool_classes : Mapping[str, str]
      +model_ids : Mapping[str, str]
      +resolve_tool_class(tool: str) : str
      +resolve_model_id(host_model: str) : str
    }
    note bottom of ConfigLoader
      Parse + contract-validate + semantic rules
      + dataclass construction: ONE act per source.
      utils supplies the mechanics; this class owns
      the source-contract pairing and the fail-fast.
      The configuration dataclasses live here, beside
      their loader.
    end note
  }

  package "utils" {
    class EnvLoader {
      +load_env(path: Path) : Mapping[str, str]
    }
    class YamlLoader {
      +load_yaml(path: Path) : dict
    }
    class JsonlStore {
      +load_entries(path: Path) : tuple[dict, ...]
      +append_entry(path: Path, obj: dict) : None
    }
    class SchemaValidator {
      +validate_instance(instance: Any, contract: Path) : tuple[str, ...]
    }
  }

  package "external (third-party)" #eeeeee {
    class "cel-python" as CelPython <<library>>
    class "jsonschema" as JsonSchemaLib <<library>>
    class "PyYAML" as PyYamlLib <<library>>
  }

  ' --- command surface: one command per harness function (1:1) ---
  Command <|.. HookCommand
  Command <|.. ResolveStepCommand
  Command <|.. ResolveStepModelCommand
  Command <|.. CheckStepPreconditionsCommand
  Command <|.. CheckStepPostconditionsCommand
  Command <|.. CheckStepAuthorizationCommand
  Command <|.. CheckStepArtifactsCommand
  Command <|.. InjectWorkflowInstructionsCommand
  Command <|.. InjectWorkflowSkillsCommand
  Command <|.. InjectStepInstructionsCommand
  Command <|.. InjectStepSkillsCommand
  Command <|.. AuditWorkflowInstanceCommand
  Command <|.. CheckWorkspaceCommand
  Command <|.. CheckConfigurationCommand
  Application ..> Command : builds + dispatches\n(composition root, at src root)
  Application ..> ConfigLoader : builds every config\ndataclass fail-fast at start

  ' --- external dependencies ---
  ConditionEvaluator ..> CelPython : compile + evaluate\nCEL selectors/predicates
  SchemaValidator ..> JsonSchemaLib : contract compilation\n+ instance validation
  YamlLoader ..> PyYamlLib : safe_load

  ' --- result <-> model correlation ---
  CheckReport "reports" o-- Report : every check finding is\na models.Report - the same\nshape the journal persists
  CheckReport o-- ConditionOutcome
  Injection o-- WorkflowPosition
  StepResolution o-- Step : the configured step,\nverbatim
  note on link
    Results embed models.Report; when a command
    journals its invocation, the result becomes the
    LogEntry payload - so every report a service
    returns is persisted verbatim in the journal.
  end note

  ' --- one dependency direction ---
  "commands" ..> "services"
  "services" ..> "workspace"
  "services" ..> "config"
  "services" ..> "models"
  "workspace" ..> "models"
  "workspace" ..> "utils"
  "config" ..> "utils"

  note bottom of "services"
    One service per harness function (1:1:1 with commands),
    grouped in subpackages by family - resolution / checking /
    injection / hooks - and each result dataclass is homed in
    the subpackage of the classes returning it, exclusively.
    Dependencies are constructor-injected private attributes;
    method names are verb + subject; commands render the typed
    results to the contract ""out"" JSON.
  end note
}

@enduml
