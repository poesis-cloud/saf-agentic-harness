# Python
__pycache__/
*.pyc
.pytest_cache

# Adapter runtime state — it belongs under XDG_STATE_HOME; ignored as belt-and-braces
.session-tracker.json

# Rendered hook registration — generated by `make install-hooks`, machine-specific
# (absolute dispatch path + absolute framework root). The source of truth is
# adapters/<env>/hooks.yaml.
.github/hooks/safe-harness.json

# Rendered H0 agent-scoped registration — same stage, same machine-specificity. The
# sources of truth are adapters/<env>/agent-hooks.yaml and the framework's own agents.
.github/agents/
