{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://safe/harness/contracts/api/resolve-step-skills.output/v1",
  "$ref": "../report.schema.json",
  "title": "resolve-step-skills output contract",
  "oneOf": [
    {
      "required": [
        "skills"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "resolved",
              "description": "Success status for resolve-step-skills."
            }
          },
          "description": "The function outcome."
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "gsmarc://safe/harness/contracts/slugs/v1#/definitions/skillSlug",
            "description": "One skill slug."
          },
          "description": "Ordered skill slugs injected into the agent's session context."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/definitions/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the resolve-step-skills harness function."
}