{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://saf/contracts/api/resolve-step-model.output/v1",
  "$ref": "gsmarc://saf/contracts/report/v1",
  "title": "resolve-step-model output contract",
  "properties": {
    "context": {
      "properties": {
        "function": {
          "const": "resolve-step-model",
          "description": "Pins this report to its function — the discriminator the log-entry envelope selects on."
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "not-applicable",
              "description": "The invoking session has no in-flight step. Returned, never journaled; hook planes render it as pass-through."
            }
          },
          "description": "The function outcome."
        }
      }
    },
    {
      "required": [
        "profile"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "resolved",
              "description": "Success status for resolve-step-model."
            }
          },
          "description": "The function outcome."
        },
        "profile": {
          "type": "object",
          "required": [
            "slug",
            "score",
            "costRank"
          ],
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "description": "Canonical model profile slug."
            },
            "score": {
              "type": "number",
              "description": "Weighted score for this step's capability demand."
            },
            "costRank": {
              "type": "integer",
              "minimum": 1,
              "description": "Relative cost rank of the selected profile."
            },
            "reason": {
              "type": "string",
              "description": "Human-readable rationale for the selection."
            }
          },
          "unevaluatedProperties": false,
          "description": "The canonical model profile selected for this step's dispatch."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "gsmarc://saf/contracts/report/v1#/$defs/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the resolve-step-model harness function."
}