{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://saf/contracts/api/start-session.output/v1",
  "$ref": "../report.schema.json",
  "title": "start-session output contract",
  "oneOf": [
    {
      "required": [
        "session"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "started",
              "description": "Success status for start-session."
            }
          },
          "description": "The function outcome."
        },
        "session": {
          "type": "object",
          "required": [
            "sessionId",
            "agent"
          ],
          "properties": {
            "agent": {
              "$ref": "gsmarc://saf/contracts/slugs/v1#/definitions/agentSlug",
              "description": "The framework-agent identity. The harness opens agent sessions — this is always present."
            },
            "sessionId": {
              "$ref": "../context.schema.json#/definitions/sessionId",
              "description": "The opened session id."
            },
            "parentSessionId": {
              "$ref": "../context.schema.json#/definitions/parentSessionId",
              "description": "The opened session's parent session id, if any."
            }
          },
          "unevaluatedProperties": false,
          "description": "The opened session metadata."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/definitions/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the start-session harness function."
}