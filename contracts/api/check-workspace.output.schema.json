{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://safe/harness/contracts/api/check-workspace.output/v1",
  "$ref": "../report.schema.json",
  "title": "check-workspace output contract",
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "valid",
              "description": "Success status for check-workspace."
            }
          },
          "description": "The function outcome."
        },
        "workspaceChecks": {
          "type": "array",
          "maxItems": 0,
          "description": "One finding per failed workspace check."
        }
      }
    },
    {
      "required": [
        "workspaceChecks"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "invalid"
            }
          }
        },
        "workspaceChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One failed workspace check finding.",
            "required": [
              "filePath",
              "failureMessage"
            ],
            "properties": {
              "filePath": {
                "type": "string",
                "minLength": 1,
                "description": "Path of the workspace artifact or file with the failure."
              },
              "failureMessage": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable failure explanation."
              }
            },
            "unevaluatedProperties": false
          },
          "description": "One finding per failed workspace check."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/definitions/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the check-workspace harness function."
}
