{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://saf/contracts/api/check-step-authorization.output/v1",
  "$ref": "gsmarc://saf/contracts/report/v1",
  "title": "check-step-authorization output contract",
  "properties": {
    "context": {
      "properties": {
        "function": {
          "const": "check-step-authorization",
          "description": "Pins this report to its function — the discriminator the log-entry envelope selects on."
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "authorization"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "allowed",
              "description": "Success status for check-step-authorization."
            }
          },
          "description": "The function outcome."
        },
        "authorization": {
          "$ref": "#/$defs/authorization",
          "not": {
            "required": [
              "failureMessage"
            ]
          },
          "description": "The authorization decision details."
        }
      }
    },
    {
      "required": [
        "authorization"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "denied"
            }
          }
        },
        "authorization": {
          "$ref": "#/$defs/authorization",
          "required": [
            "failureMessage"
          ]
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "gsmarc://saf/contracts/report/v1#/$defs/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "authorization": {
      "type": "object",
      "required": [
        "actor",
        "artifactPath",
        "action",
        "resource"
      ],
      "properties": {
        "actor": {
          "$ref": "gsmarc://saf/contracts/slugs/v1#/$defs/agentSlug",
          "description": "The acting agent identity."
        },
        "artifactPath": {
          "$ref": "gsmarc://saf/contracts/artifact/v1#/$defs/artifactPath",
          "description": "The target artifact path."
        },
        "action": {
          "$ref": "gsmarc://saf/contracts/conf/framework/access-control-list.conf/v1#/$defs/action",
          "description": "The requested action."
        },
        "resource": {
          "$ref": "gsmarc://saf/contracts/slugs/v1#/$defs/artifactSlug",
          "description": "The artifact schema slug the privilege applies to — the resource under test, resolved from the write path (function 8, invariant 2)."
        },
        "failureMessage": {
          "type": "string",
          "minLength": 1,
          "description": "Why authorization was denied."
        }
      },
      "unevaluatedProperties": false,
      "description": "Authorization decision details."
    }
  },
  "description": "Output contract for the check-step-authorization harness function."
}