{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://saf/contracts/api/check-step-preconditions.output/v1",
  "$ref": "gsmarc://saf/contracts/report/v1",
  "title": "check-step-preconditions output contract",
  "properties": {
    "context": {
      "properties": {
        "function": {
          "const": "check-step-preconditions",
          "description": "Pins this report to its function — the discriminator the log-entry envelope selects on, and what makes this contract distinct from the structurally identical check-step-postconditions output."
        }
      }
    }
  },
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "not-applicable",
              "description": "The invoking session has no in-flight step. Returned, never journaled; hook planes render it as pass-through."
            }
          },
          "description": "The function outcome."
        }
      }
    },
    {
      "required": [
        "conditionChecks"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "pass",
              "description": "Success status for check-step-preconditions."
            }
          },
          "description": "The function outcome."
        },
        "conditionChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "outcome"
            ],
            "properties": {
              "condition": {
                "oneOf": [
                  {
                    "$ref": "gsmarc://saf/contracts/conf/framework/workflow.conf/v1#/$defs/stepCondition"
                  },
                  {
                    "$ref": "gsmarc://saf/contracts/conf/framework/workflow.conf/v1#/$defs/stateCondition"
                  }
                ],
                "description": "The condition that was checked."
              },
              "outcome": {
                "const": "pass",
                "description": "Whether the condition passed or failed."
              },
              "failureMessage": {
                "type": "string",
                "minLength": 1,
                "description": "Explanation when the condition failed."
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "fail"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "failureMessage"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "failureMessage"
                ]
              }
            },
            "unevaluatedProperties": false,
            "description": "One condition outcome; failure requires a failureMessage."
          },
          "description": "One outcome entry per condition checked."
        }
      }
    },
    {
      "required": [
        "conditionChecks"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "fail"
            }
          }
        },
        "conditionChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "outcome"
            ],
            "properties": {
              "condition": {
                "oneOf": [
                  {
                    "$ref": "gsmarc://saf/contracts/conf/framework/workflow.conf/v1#/$defs/stepCondition"
                  },
                  {
                    "$ref": "gsmarc://saf/contracts/conf/framework/workflow.conf/v1#/$defs/stateCondition"
                  }
                ],
                "description": "The condition that was checked."
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ],
                "description": "Whether the condition passed or failed."
              },
              "failureMessage": {
                "type": "string",
                "minLength": 1,
                "description": "Explanation when the condition failed."
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "fail"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "failureMessage"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "failureMessage"
                ]
              }
            },
            "unevaluatedProperties": false,
            "description": "One condition outcome; at least one must be fail."
          },
          "contains": {
            "properties": {
              "outcome": {
                "const": "fail"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "description": "One outcome entry per condition checked; at least one must be fail."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "gsmarc://saf/contracts/report/v1#/$defs/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the check-step-preconditions harness function."
}