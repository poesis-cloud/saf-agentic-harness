{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://safe/harness/contracts/api/resolve-workflow-instructions.output/v1",
  "$ref": "../report.schema.json",
  "title": "resolve-workflow-instructions output contract",
  "oneOf": [
    {
      "required": [
        "instructions"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "resolved",
              "description": "Success status for resolve-workflow-instructions."
            }
          },
          "description": "The function outcome."
        },
        "instructions": {
          "type": "array",
          "items": {
            "$ref": "gsmarc://safe/harness/contracts/slugs/v1#/definitions/instructionSlug",
            "description": "One instruction slug."
          },
          "minItems": 1,
          "description": "Ordered instruction slugs injected into the agent's session context."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/definitions/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the resolve-workflow-instructions harness function."
}