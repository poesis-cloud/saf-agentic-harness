{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gsmarc://safe/harness/contracts/api/register-session.output/v1",
  "$ref": "../report.schema.json",
  "title": "register-session output contract",
  "oneOf": [
    {
      "required": [
        "session"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "registered",
              "description": "Success status for register-session."
            }
          },
          "description": "The function outcome."
        },
        "session": {
          "type": "object",
          "required": [
            "sessionId"
          ],
          "properties": {
            "agent": {
              "$ref": "gsmarc://safe/harness/contracts/slugs/v1#/definitions/agentSlug",
              "description": "The framework-agent identity, when applicable."
            },
            "sessionId": {
              "$ref": "../context.schema.json#/definitions/sessionId",
              "description": "The registered session id."
            },
            "parentSessionId": {
              "$ref": "../context.schema.json#/definitions/parentSessionId",
              "description": "The registered parent session id, if any."
            }
          },
          "unevaluatedProperties": false,
          "description": "The registered session metadata."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/definitions/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the register-session harness function."
}
