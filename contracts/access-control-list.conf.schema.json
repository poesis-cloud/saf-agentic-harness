{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://poesis.cloud/safe-agentic-framework/access-control-list.conf.schema.json",
    "title": "Access-control-list configuration schema",
    "description": "Validation schema for conf/access-control-list.conf.yaml: whole-resource RBAC. Actors (agent files) hold roles; each role carries privileges of exactly one artifact plus one action verb (CREATE|READ|UPDATE|DELETE).",
    "type": "object",
    "additionalProperties": false,
    "required": ["actors", "roles"],
    "properties": {
        "actors": {
            "description": "The agents known to the framework, each with the roles it holds.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "roles"],
                "properties": {
                    "id": {
                        "description": "The agent filename (e.g. business-owner.agent.md).",
                        "type": "string",
                        "pattern": "^[a-z0-9-]+\\.agent\\.md$"
                    },
                    "roles": {
                        "description": "Role ids assigned to this actor.",
                        "type": "array",
                        "minItems": 1,
                        "items": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                }
            }
        },
        "roles": {
            "description": "Named privilege sets. Each privilege is one artifact plus one action verb.",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "privileges"],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "privileges": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["artifact", "action"],
                            "properties": {
                                "artifact": {
                                    "description": "The artifact schema filename (or its stem) the privilege applies to.",
                                    "type": "string",
                                    "minLength": 1
                                },
                                "action": {
                                    "enum": ["CREATE", "READ", "UPDATE", "DELETE"]
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
