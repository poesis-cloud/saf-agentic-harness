{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://poesis.cloud/safe-agentic-framework/model-profiles.conf.schema.json",
    "title": "Model profile catalog configuration schema",
    "description": "Validation schema for the conf/model-profiles.conf.yaml catalog. Owns the canonical capability-tag vocabulary (#/definitions/capabilities): the same tag->0-10 map shape scored per model here and weighted per workflow step in conf/workflows/*.workflow.conf.yaml.",
    "type": "object",
    "additionalProperties": false,
    "required": ["models"],
    "properties": {
        "models": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "cost_rank", "capability_scores"],
                "properties": {
                    "id": {
                        "type": "string",
                        "minLength": 1
                    },
                    "cost_rank": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                    },
                    "description": {
                        "type": "string"
                    },
                    "notes": {
                        "type": "string"
                    },
                    "capability_scores": {
                        "description": "0-10 relative judgments per capability tag.",
                        "$ref": "#/definitions/capabilities"
                    }
                }
            }
        }
    },
    "definitions": {
        "capabilities": {
            "description": "Canonical capability-tag vocabulary: map of capability tag -> number (0-10). Used as scores in the model catalog and as weights on workflow steps.",
            "type": "object",
            "properties": {
                "deep-reasoning": { "type": "number", "minimum": 0, "maximum": 10 },
                "coding": { "type": "number", "minimum": 0, "maximum": 10 },
                "tool-use": { "type": "number", "minimum": 0, "maximum": 10 },
                "long-context": { "type": "number", "minimum": 0, "maximum": 10 },
                "multimodal": { "type": "number", "minimum": 0, "maximum": 10 },
                "writing-quality": { "type": "number", "minimum": 0, "maximum": 10 },
                "instruction-following": { "type": "number", "minimum": 0, "maximum": 10 },
                "fast-iteration": { "type": "number", "minimum": 0, "maximum": 10 },
                "schema-adherence": { "type": "number", "minimum": 0, "maximum": 10 }
            },
            "additionalProperties": false
        }
    }
}