{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/functions/check-configuration.output.schema.json",
  "$ref": "../report.schema.json",
  "title": "check-configuration output contract",
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "valid",
              "description": "Success status for check-configuration."
            }
          },
          "description": "The function outcome."
        },
        "configurationChecks": {
          "type": "array",
          "maxItems": 0,
          "description": "One finding per failed configuration check."
        }
      }
    },
    {
      "required": [
        "configurationChecks"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "invalid"
            }
          }
        },
        "configurationChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "description": "One failed configuration check finding.",
            "required": [
              "filePath",
              "failureMessage"
            ],
            "properties": {
              "filePath": {
                "type": "string",
                "minLength": 1,
                "description": "Path of the configuration file or .env variable with the failure."
              },
              "failureMessage": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable failure explanation."
              }
            },
            "unevaluatedProperties": false
          },
          "description": "One finding per failed configuration check."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/$defs/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the check-configuration harness function."
}