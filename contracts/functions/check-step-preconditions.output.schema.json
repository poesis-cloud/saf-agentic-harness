{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/functions/check-step-preconditions.output.schema.json",
  "$ref": "../report.schema.json",
  "title": "check-step-preconditions output contract",
  "oneOf": [
    {
      "required": [
        "conditionChecks"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "pass",
              "description": "Success status for check-step-preconditions."
            }
          },
          "description": "The function outcome."
        },
        "conditionChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "outcome"
            ],
            "properties": {
              "condition": {
                "$ref": "../conf/workflow.conf.schema.json#/definitions/condition",
                "description": "The condition that was checked."
              },
              "outcome": {
                "const": "pass",
                "description": "Whether the condition passed or failed."
              },
              "failureMessage": {
                "type": "string",
                "minLength": 1,
                "description": "Explanation when the condition failed."
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "fail"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "failureMessage"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "failureMessage"
                ]
              }
            },
            "unevaluatedProperties": false,
            "description": "One condition outcome; failure requires a failureMessage."
          },
          "description": "One outcome entry per condition checked."
        }
      }
    },
    {
      "required": [
        "conditionChecks"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "fail"
            }
          }
        },
        "conditionChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "condition",
              "outcome"
            ],
            "properties": {
              "condition": {
                "$ref": "../conf/workflow.conf.schema.json#/definitions/condition",
                "description": "The condition that was checked."
              },
              "outcome": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail"
                ],
                "description": "Whether the condition passed or failed."
              },
              "failureMessage": {
                "type": "string",
                "minLength": 1,
                "description": "Explanation when the condition failed."
              }
            },
            "if": {
              "properties": {
                "outcome": {
                  "const": "fail"
                }
              },
              "required": [
                "outcome"
              ]
            },
            "then": {
              "required": [
                "failureMessage"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "failureMessage"
                ]
              }
            },
            "unevaluatedProperties": false,
            "description": "One condition outcome; at least one must be fail."
          },
          "contains": {
            "properties": {
              "outcome": {
                "const": "fail"
              }
            },
            "required": [
              "outcome"
            ]
          },
          "description": "One outcome entry per condition checked; at least one must be fail."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/$defs/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the check-step-preconditions harness function."
}
