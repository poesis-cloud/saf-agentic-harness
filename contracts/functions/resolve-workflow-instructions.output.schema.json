{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/functions/resolve-workflow-instructions.output.schema.json",
  "$ref": "../report.schema.json",
  "title": "resolve-workflow-instructions output contract",
  "oneOf": [
    {
      "required": [
        "instructions"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "resolved",
              "description": "Success status for resolve-workflow-instructions."
            }
          },
          "description": "The function outcome."
        },
        "instructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "One instruction reference."
          },
          "minItems": 1,
          "description": "Ordered instruction refs injected into the agent's session context."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/$defs/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the resolve-workflow-instructions harness function."
}