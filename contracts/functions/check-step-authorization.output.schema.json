{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/functions/check-step-authorization.output.schema.json",
  "$ref": "../report.schema.json",
  "title": "check-step-authorization output contract",
  "oneOf": [
    {
      "required": [
        "authorization"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "allowed",
              "description": "Success status for check-step-authorization."
            }
          },
          "description": "The function outcome."
        },
        "authorization": {
          "$ref": "#/$defs/authorization",
          "not": {
            "required": [
              "failureMessage"
            ]
          },
          "description": "The authorization decision details."
        }
      }
    },
    {
      "required": [
        "authorization"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "denied"
            }
          }
        },
        "authorization": {
          "$ref": "#/$defs/authorization",
          "required": [
            "failureMessage"
          ]
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/$defs/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "$defs": {
    "authorization": {
      "type": "object",
      "required": [
        "actor",
        "artifactPath",
        "action",
        "resource"
      ],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1,
          "description": "The acting agent identity."
        },
        "artifactPath": {
          "type": "string",
          "minLength": 1,
          "description": "The target artifact path."
        },
        "action": {
          "$ref": "../actions.schema.json#/$defs/writeAction",
          "description": "The requested write action."
        },
        "resource": {
          "type": "string",
          "minLength": 1,
          "description": "The artifact schema/resource the privilege applies to."
        },
        "failureMessage": {
          "type": "string",
          "minLength": 1,
          "description": "Why authorization was denied."
        }
      },
      "unevaluatedProperties": false,
      "description": "Authorization decision details."
    }
  },
  "description": "Output contract for the check-step-authorization harness function."
}
