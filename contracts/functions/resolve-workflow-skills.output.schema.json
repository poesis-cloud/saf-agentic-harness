{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/functions/resolve-workflow-skills.output.schema.json",
  "$ref": "../report.schema.json",
  "title": "resolve-workflow-skills output contract",
  "oneOf": [
    {
      "required": [
        "skills"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "resolved"
            }
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/$defs/errorStatus"
            }
          },
          "required": [
            "error"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
