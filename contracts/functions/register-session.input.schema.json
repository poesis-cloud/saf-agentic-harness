{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/functions/register-session.input.schema.json",
  "title": "register-session input contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sessionId"
  ],
  "properties": {
    "agent": {
      "type": "string",
      "minLength": 1,
      "description": "The framework-agent identity, when applicable."
    },
    "sessionId": {
      "$ref": "../context.schema.json#/$defs/sessionId",
      "description": "The session this invocation runs in."
    },
    "parentSessionId": {
      "$ref": "../context.schema.json#/$defs/parentSessionId",
      "description": "The parent session that opened this session, if any."
    }
  },
  "description": "Input contract for the register-session harness function."
}
