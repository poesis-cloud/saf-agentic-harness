{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/functions/check-workspace.output.schema.json",
  "$ref": "../report.schema.json",
  "title": "check-workspace output contract",
  "oneOf": [
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "valid"
            }
          }
        },
        "workspaceChecks": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    {
      "required": [
        "workspaceChecks"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "invalid"
            }
          }
        },
        "workspaceChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "filePath",
              "failureMessage"
            ],
            "properties": {
              "filePath": {
                "type": "string",
                "minLength": 1
              },
              "failureMessage": {
                "type": "string",
                "minLength": 1
              }
            },
            "unevaluatedProperties": false
          }
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/$defs/errorStatus"
            }
          },
          "required": [
            "error"
          ]
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
