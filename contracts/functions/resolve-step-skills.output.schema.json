{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/functions/resolve-step-skills.output.schema.json",
  "$ref": "../report.schema.json",
  "title": "resolve-step-skills output contract",
  "oneOf": [
    {
      "required": [
        "skills"
      ],
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "const": "resolved",
              "description": "Success status for resolve-step-skills."
            }
          },
          "description": "The function outcome."
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "description": "One skill id."
          },
          "description": "Ordered skill ids injected into the agent's session context."
        }
      }
    },
    {
      "properties": {
        "outcome": {
          "properties": {
            "status": {
              "$ref": "../report.schema.json#/$defs/errorStatus",
              "description": "Error status."
            }
          },
          "required": [
            "error"
          ],
          "description": "The function outcome on error."
        }
      }
    }
  ],
  "unevaluatedProperties": false,
  "description": "Output contract for the resolve-step-skills harness function."
}