{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poesis.cloud/safe-agentic-framework/report.schema.json",
  "title": "Harness report envelope contract",
  "description": "Generic report envelope shared by every harness function. Function output contracts extend this envelope with function-specific result properties; error outcomes use the same envelope and optional error detail. Every function's `out` value is a concrete report: the exact object returned by the service, rendered by the command, forwarded unchanged by the hook adapter, and persisted byte-identically as the log entry's `report` (see log-entry.schema.json).",
  "type": "object",
  "required": [
    "context",
    "outcome"
  ],
  "properties": {
    "context": {
      "$ref": "context.schema.json"
    },
    "outcome": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "minLength": 1
        },
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "minLength": 1
            },
            "message": {
              "type": "string",
              "minLength": 1
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "unevaluatedProperties": false
        }
      },
      "if": {
        "properties": {
          "status": {
            "$ref": "#/$defs/errorStatus"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "error"
        ]
      },
      "else": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  },
  "$defs": {
    "errorStatus": {
      "type": "string",
      "enum": [
        "input-error",
        "state-error",
        "configuration-error",
        "adapter-error",
        "system-error"
      ]
    }
  }
}
