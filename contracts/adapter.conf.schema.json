{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://poesis.cloud/safe-agentic-framework/adapter.conf.schema.json",
    "title": "Host adapter binding configuration schema",
    "description": "Validation schema for harness/adapters/<env>/tools.yaml: the host-specific tool/payload binding the HookService reads. INTERNAL configuration — harness-owned (ships with the harness, resolved structurally), unlike the conf/*.conf.yaml files which are the embedding framework's EXTERNAL configuration. Both families go through the same one-act loader (parse + contract-validate); only ownership and location differ.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "write_tools",
        "tool_keys",
        "input_keys",
        "path_keys",
        "actor_keys",
        "session_keys"
    ],
    "properties": {
        "write_tools": {
            "description": "host tool name -> action verb (create|update).",
            "type": "object",
            "additionalProperties": {
                "enum": [
                    "create",
                    "update"
                ]
            }
        },
        "delete_tools": {
            "description": "Host tool names that delete files.",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "tool_keys": {
            "$ref": "#/definitions/keyList"
        },
        "input_keys": {
            "$ref": "#/definitions/keyList"
        },
        "path_keys": {
            "$ref": "#/definitions/keyList"
        },
        "actor_keys": {
            "$ref": "#/definitions/keyList"
        },
        "session_keys": {
            "$ref": "#/definitions/keyList"
        },
        "dispatch_tools": {
            "description": "Host tool names that start a child step-session (subagent dispatch).",
            "type": "array",
            "items": {
                "type": "string",
                "minLength": 1
            }
        },
        "dispatch_agent_keys": {
            "$ref": "#/definitions/keyList"
        },
        "dispatch_model_keys": {
            "$ref": "#/definitions/keyList"
        }
    },
    "definitions": {
        "keyList": {
            "description": "Ordered payload field names to probe (first hit wins).",
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    }
}